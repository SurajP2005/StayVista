<style>
.search-btn{
    background-color:#fe424d;
    color:#fff;
    border-radius:25px;
    padding:0.4rem 0.8rem;
    font-size:0.9rem;
}

.search-btn:hover{
    background-color:#fe424d;
    color:#fff;
}

.search-btn i{
    margin-right:0.3rem;
}

.search-inp{
    width:180px;
    border-radius:25px;
    padding:0.4rem 1rem;
    font-size:0.9rem;
}

.ai-link{
    margin-left:15px;
    white-space:nowrap;
    font-weight:600;
    color:#fe424d !important;
}
.navbar-brand{
    font-size:1.7rem;
    color:#fe424d !important;
}

.brand-name{
    font-size:1.35rem;
    font-weight:700;
    margin-left:8px;
    color:#fe424d;
}

</style>

<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center" href="/listings">
    <i class="fa-regular fa-compass"></i>
    <span class="brand-name">StayVista</span>
</a>
    <button class="navbar-toggler" 
    type="button" 
    data-bs-toggle="collapse" 
    data-bs-target="#navbarNavAltMarkup" 
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

 <div class="d-flex align-items-center ms-auto">

    <form class="d-flex" role="search" action="/listings" method="GET">

        <input
            class="form-control search-inp"
            type="search"
            name="search"
            placeholder="Search..."
            required
        >

        <button class="btn search-btn ms-2" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
        </button>

    </form>

    <a class="nav-link ai-link" href="/trip-planner">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        AI Trip Planner
    </a>

</div>

      <div class="navbar-nav ms-auto">
      <a class="nav-link" href="/listings/new">StayVista your home</a>
        <% if (!currUser) {%>
        <a class="nav-link " href="/signup"><b>Signup</b></a>
        <a class="nav-link" href="/login"><b>Log in</b></a>
       <% } %>
       <% if(currUser) { %>
        <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>



    </div>
  </div>
</nav>